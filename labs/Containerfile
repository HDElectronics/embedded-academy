# The Embedded Academy lab container: cross toolchains, QEMU and the build
# dependencies of U-Boot, TF-A, OP-TEE, Linux and Buildroot.
# Start it with labs/lab.sh.

FROM docker.io/library/debian:trixie

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      bc bison build-essential ca-certificates cpio device-tree-compiler \
      dosfstools fdisk file flex gcc-aarch64-linux-gnu gcc-arm-linux-gnueabihf \
      gdb-multiarch git ipxe-qemu less libc6-dev-arm64-cross \
      libc6-dev-armhf-cross libgnutls28-dev libssl-dev make \
      mtools perl python3 python3-cryptography python3-dev python3-pyelftools \
      python3-setuptools qemu-system-arm qemu-utils rsync swig u-boot-tools \
      unzip uuid-dev wget xz-utils \
 && rm -rf /var/lib/apt/lists/*

RUN useradd --create-home --uid 1000 --shell /bin/bash learner

USER learner
WORKDIR /home/learner
