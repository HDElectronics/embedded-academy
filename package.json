{
  "name": "embedded-academy",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @ea/site dev",
    "build": "pnpm --filter @ea/ui build:tokens && pnpm --filter @ea/site build",
    "preview": "pnpm --filter @ea/site preview",
    "lint": "pnpm run --sequential \"/^lint:(?!fix).*/\"",
    "lint:biome": "biome check .",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check \"**/*.{astro,mdx}\"",
    "lint:css": "stylelint \"**/*.{css,astro}\"",
    "lint:md": "markdownlint-cli2",
    "lint:prose": "vale content docs README.md CONTRIBUTING.md",
    "lint:fix": "biome check --write . && eslint --fix . && prettier --write \"**/*.{astro,mdx}\" && stylelint --fix \"**/*.{css,astro}\"",
    "format": "biome format --write . && prettier --write \"**/*.{astro,mdx}\"",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "docs:build": "uv run --with-requirements docs/requirements.txt sphinx-build -W --keep-going -b html docs docs/_build/html",
    "docs:linkcheck": "uv run --with-requirements docs/requirements.txt sphinx-build -b linkcheck docs docs/_build/linkcheck",
    "reuse": "uvx --from reuse[charset-normalizer] reuse lint",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@ea/anim": "workspace:*",
    "@ea/ui": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@vitest/coverage-v8": "^5.0.3",
    "@vvago/vale": "^3.24.0",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-mdx": "^3.8.1",
    "happy-dom": "^20.14.6",
    "lefthook": "^2.2.1",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-html": "^2.0.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
