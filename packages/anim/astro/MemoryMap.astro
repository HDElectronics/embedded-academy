---
// SPDX-FileCopyrightText: Embedded Academy contributors
// SPDX-License-Identifier: MIT
import { getBoard, type Board } from '@ea/boards';
import { readBoardLog } from '@ea/boards/node';
import { chainState, renderMemory, toChainBoard } from '../src/index.ts';

interface Props {
  board: Board['id'];
  /** Show which stages ran in each region, up to this stage index. Omit for addresses only. */
  upTo?: number;
  pane?: number;
}

const { board: id, upTo, pane = 1 } = Astro.props;
const board = getBoard(id);
const data = toChainBoard(board, readBoardLog(board));
const state = upTo === undefined ? undefined : chainState(data, upTo);
---

<section class="ea-pane" aria-label={`Memory map, ${board.name}`}>
  <div class="ea-pane__bar">
    <span class="ea-pane__id">{pane}:</span>
    <span class="ea-pane__title">memory-map</span>
    <span class="ea-pane__meta">{board.soc}</span>
  </div>
  <div class="ea-pane__body">
    <div class="ea-memmap" set:html={renderMemory(data, state)} />
  </div>
</section>
