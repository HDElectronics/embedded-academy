---
// SPDX-FileCopyrightText: Embedded Academy contributors
// SPDX-License-Identifier: MIT
import { boards as allBoards, type Board } from '@ea/boards';
import { readBoardLog } from '@ea/boards/node';
import {
  chainState,
  renderConsole,
  renderDetail,
  renderMemory,
  renderRail,
  renderTabs,
  toChainBoard,
} from '../src/index.ts';

interface Props {
  /** Boards to offer, in tab order. Defaults to all boards. */
  boards?: Board['id'][];
  /** Pane title. */
  label?: string;
  /** Pane index shown in the title bar. */
  pane?: number;
}

const { boards: ids = allBoards.map((b) => b.id), label = 'boot-chain', pane = 0 } = Astro.props;
const data = ids.map((id) => {
  const board = allBoards.find((b) => b.id === id);
  if (!board) throw new Error(`BootChain: unknown board ${id}`);
  return toChainBoard(board, readBoardLog(board));
});
const first = data[0];
if (!first) throw new Error('BootChain: no boards');
const state = chainState(first, 0);
const json = JSON.stringify(data).replace(/</g, '\u003c');
---

<ea-boot-chain class="ea-chain" data-window="boot-chain" data-initial-board="0" data-initial-stage="0">
  <script is:inline type="application/json" data-chain set:html={json} />
  <section class="ea-pane ea-pane--active" aria-label="Boot chain">
    <div class="ea-pane__bar">
      <span class="ea-pane__id">{pane}:</span>
      <span class="ea-pane__title">{label}</span>
      <span class="ea-pane__meta" data-part="meta">
        {first.soc} · {first.cpu}
      </span>
    </div>
    <div class="ea-pane__body ea-chain__body">
      {data.length > 1 && (
        <div class="ea-tabs" role="tablist" aria-label="Board" data-part="tabs" set:html={renderTabs(data, 0)} />
      )}
      <p class="ea-chain__summary" data-part="summary">
        {first.summary}
      </p>
      <div class="ea-chain__controls">
        <button type="button" class="ea-btn" data-part="prev">
          Previous
        </button>
        <button type="button" class="ea-btn ea-btn--primary" data-part="play" aria-pressed="false">
          Play boot
        </button>
        <button type="button" class="ea-btn" data-part="next">
          Next
        </button>
        <p class="visually-hidden" aria-live="polite" data-part="status"></p>
      </div>
      <ol class="ea-chain__rail" data-part="rail" aria-label="Boot stages" set:html={renderRail(first, state)} />
      <div class="ea-chain__grid">
        <div class="ea-chain__detail" data-part="detail" set:html={renderDetail(first, state)} />
        <div>
          <p class="ea-pane__label">Where it runs</p>
          <div class="ea-memmap" data-part="memory" set:html={renderMemory(first, state)} />
        </div>
        <div>
          <p class="ea-pane__label">Serial · 115200 8N1{first.logIllustrative ? ' · illustrative' : ''}</p>
          <div
            class="ea-console"
            role="log"
            tabindex="0"
            aria-label="Serial console"
            data-part="console"
            set:html={renderConsole(state.lines) + '<span class="ea-console__cursor" aria-hidden="true"></span>'}
          />
        </div>
      </div>
    </div>
  </section>
</ea-boot-chain>

<script>
  import '@ea/anim/client';
</script>
