<button type="button" class="ea-btn theme-toggle" data-theme-toggle aria-pressed="false">
  <span class="theme-toggle__key">theme: </span>tty
</button>

<script>
  const NAMES = { dark: 'tty', light: 'paper' } as const;

  function apply(button: HTMLButtonElement): void {
    const theme = document.documentElement.dataset.theme === 'light' ? 'light' : 'dark';
    const key = button.querySelector('.theme-toggle__key');
    button.replaceChildren(...(key ? [key] : []), NAMES[theme]);
    button.setAttribute('aria-pressed', String(theme === 'light'));
    button.setAttribute(
      'aria-label',
      `Theme: ${NAMES[theme]}. Switch to ${theme === 'light' ? 'tty (dark)' : 'paper (light)'}`,
    );
  }

  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    apply(button);
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('ea-theme', next);
      } catch {}
      apply(button);
    });
  }
</script>
